# AtlasPay — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Database
ATLASPAY_DB_URL=jdbc:mysql://localhost:3306/atlaspay?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
ATLASPAY_DB_USERNAME=atlaspay
ATLASPAY_DB_PASSWORD=atlaspay

# Security
ATLASPAY_JWT_SECRET=replace-with-256-bit-random-secret
ATLASPAY_JWT_EXPIRY_MINUTES=60
ATLASPAY_APIKEY_HMAC_SECRET=replace-with-random-server-secret

# External providers
ANCHOR_BASE_URL=https://api.getanchor.co
ANCHOR_API_KEY=your_anchor_api_key

DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=your_dojah_app_id
DOJAH_PRIVATE_KEY=your_dojah_private_key

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Observability
ATLASPAY_ENV=local
ATLASPAY_TRACE_SAMPLING=1.0
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_EXPORTER=none
